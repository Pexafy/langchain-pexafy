{
  "name": "langchain-pexafy",
  "version": "0.1.0",
  "description": "LangChain.js tools for Pexafy: semantic search over 9M+ free stock photos from Unsplash, Pexels, Pixabay and more",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit.test.ts",
    "test:live": "vitest run test/live.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "langchain",
    "langchainjs",
    "langgraph",
    "agents",
    "tools",
    "stock photos",
    "image search",
    "semantic search",
    "unsplash",
    "pexels",
    "pixabay"
  ],
  "author": "Marouane Tijani <marouane@pexafy.com>",
  "license": "MIT",
  "homepage": "https://docs.pexafy.com/langchain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pexafy/langchain-pexafy.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/Pexafy/langchain-pexafy/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.40 || ^1.0.0",
    "zod": "^3.25.76 || ^4"
  },
  "devDependencies": {
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.20",
    "@langchain/openai": "^1.5.8",
    "@types/node": "^26.6.4",
    "langchain": "^1.5.15",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
